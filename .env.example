# One JSON object maps stable QR slugs to changeable destinations.
QR_REDIRECTS_JSON={"futas":"https://www.facebook.com/events/REPLACE_WITH_EVENT_ID"}

# Local values used by `npm run dev:local`. In Vercel, the Upstash integration
# supplies production values with the same variable names automatically.
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=local-dev-token
